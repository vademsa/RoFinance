{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["RoFinance-Mobile"],
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:mobile": "npm run dev --workspace rofinance-mobile",
    "dev:api": "tsx server.ts",
    "build": "npm run build:web && npm run build:api && npm run build:web-server",
    "build:web": "vite build",
    "build:mobile": "npm run build --workspace rofinance-mobile",
    "sync:mobile": "npm run sync --workspace rofinance-mobile",
    "build:api": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/api.cjs",
    "build:web-server": "esbuild webServer.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/web-server.cjs",
    "start": "node dist/web-server.cjs",
    "start:web": "node dist/web-server.cjs",
    "start:api": "node dist/api.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test:logic": "tsx --test src/utils/*.test.ts server/*.test.ts",
    "lint:mobile": "npm run lint --workspace rofinance-mobile"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "http-proxy": "^1.18.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.15.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
