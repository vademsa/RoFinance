# Required: fill these in your local .env.local or deployment environment.
DATABASE_URL=
SESSION_SECRET=

# Optional until mobile clients are enabled. Supply your own random 32-byte-or-longer
# base64 key in a JSON map, and select its key id. Keep old ids during rotation.
MOBILE_JWT_ACTIVE_KID=
MOBILE_JWT_KEYS=
# Default: capacitor://localhost,https://localhost
MOBILE_ALLOWED_ORIGINS=

# Optional: leave blank unless needed for your setup.
DATABASE_SSL=
DATABASE_POOL_SIZE=
APP_URL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional internal process addresses. Keep the API on loopback and expose only
# the web process through your HTTPS reverse proxy or tunnel.
API_PORT=
WEB_PORT=
API_INTERNAL_URL=
